// -*- C++ -*-  THE SETTINGS TABLE. One file, three artifacts -- the same shape as ActionId.def (D1-6).
//
// The constexpr `Key<T>` objects, the runtime descriptor table, and the group census are ALL
// generated from the rows below. The alternative -- constexpr keys in the header and a hand-written
// descriptor list in the .cpp -- is two lists that agree until the first Friday, and the second one
// is the one a Preferences page is built from, so the drift shows up as a missing row in the UI
// rather than as a compile error.
//
// This file is #included repeatedly with different macro definitions. No include guard, on purpose.
//
//   RAWPAGE_SETTING(Namespace, Name, Type, "path", Default, Group, PolicyLockable)
//   RAWPAGE_SETTING_RANGED(Namespace, Name, Type, "path", Default, Group, PolicyLockable, Min, Max)
//
// ---------------------------------------------------------------------------------------------
// FOUR RULES, none of them stylistic:
//
// 1. THE PATH IS A PERMANENT PUBLIC NAME, exactly as an ActionId string is. It is written into a
//    user's settings.ini and read back by a later version. Changing one without a migration step in
//    SettingsSchema.cpp silently resets that preference (D1-16).
//
// 2. THE DEFAULT LIVES HERE AND NOWHERE ELSE. A default repeated at a call site is a default that
//    disagrees with this table the first time one of them changes -- and `Settings::get` never asks
//    a caller for one, which is what makes that impossible rather than discouraged.
//
// 3. A RANGE IS ENFORCED BY CLAMPING, NOT BY REFUSAL. A hand-edited INI or a downgraded install
//    must not prevent startup (guide case A-43); the clamp is logged so it is diagnosable.
//
// 4. `Internal` GROUP MEANS "NOT A USER SETTING". It lives in the same file and is versioned with
//    everything else, but it gets no Preferences row. `meta/schemaVersion` and the recent-files
//    list are internal state, not preferences, and the guide says so of the first one already.
// ---------------------------------------------------------------------------------------------

#ifndef RAWPAGE_SETTING
#define RAWPAGE_SETTING(Namespace, Name, Type, Path, Default, Group, PolicyLockable)
#endif

// A ranged key is a separate macro rather than two more columns on every row, so that the 9 keys
// with no meaningful ordering (a theme, a locale, a list of paths) cannot be given a nonsense range
// by copy-paste.
#ifndef RAWPAGE_SETTING_RANGED
#define RAWPAGE_SETTING_RANGED(Namespace, Name, Type, Path, Default, Group, PolicyLockable, Min, Max) \
    RAWPAGE_SETTING(Namespace, Name, Type, Path, Default, Group, PolicyLockable)
#endif

// =============================================================================================
// The twelve Stage 1 keys -- Implementation-Plan.md, Stage 1 "Data / settings keys".
//
// Eleven of the twelve are here. The twelfth, `shortcuts/<context>/<action>`, is a KEY FAMILY and
// deliberately not a row: it is generated over KeyContext x ActionId by SettingsSchema.h, because a
// row per (context, action) pair would be 12 x 358 rows that no human maintains. D1-10 requires the
// family to be declared once with a validator, not to be an open string API -- see ShortcutKey.
// =============================================================================================

// --- General ---------------------------------------------------------------------------------
RAWPAGE_SETTING(general, theme, Theme,
                "general/theme", Theme::FollowSystem, General, true)

// 0.75 is the smallest scale at which the 9 px ribbon key tips stay legible; 2.0 is where a
// maximised ribbon stops fitting three groups on a 1920-wide monitor. Both are judged at T10 and
// may move; they may not quietly become unbounded.
RAWPAGE_SETTING_RANGED(general, uiFontScale, double,
                       "general/uiFontScale", 1.0, General, true, 0.75, 2.0)

RAWPAGE_SETTING(general, touchMode, bool,
                "general/touchMode", false, General, true)

RAWPAGE_SETTING(general, restoreSession, bool,
                "general/restoreSession", true, General, true)

RAWPAGE_SETTING(general, singleInstance, bool,
                "general/singleInstance", true, General, true)

// S4 T13, D4-9. THREE SWITCHES AND NOT ONE, because restoring a session and restoring a LAYOUT are
// different appetites: a person who wants their documents back on a laptop they dock and undock
// does not necessarily want yesterday's window rectangle chased across two monitors, and a person
// who lives in the thumbnails pane does not want it re-opened on a machine where they do not.
// `restoreSession` above is the master -- off, nothing is restored and nothing is captured -- and
// these two subtract from what it brings back.
RAWPAGE_SETTING(general, rememberPaneLayout, bool,
                "general/rememberPaneLayout", true, General, true)

RAWPAGE_SETTING(general, rememberWindowLayout, bool,
                "general/rememberWindowLayout", true, General, true)

// --- Language --------------------------------------------------------------------------------
// Empty means "follow the system locale". A sentinel string such as "system" would be a value the
// locale space could one day legitimately contain; empty cannot be a locale name.
RAWPAGE_SETTING(language, uiLocale, QString,
                "language/uiLocale", "", Language, true)

// --- Logging ---------------------------------------------------------------------------------
RAWPAGE_SETTING(logging, level, LogLevel,
                "logging/level", LogLevel::Info, Logging, true)

// A mask over core/Log.h's seven subsystems. Default is all of them: a log that omits a subsystem
// by default is a log that omits exactly the subsystem the support case is about.
RAWPAGE_SETTING(logging, subsystems, LogSubsystemMask,
                "logging/subsystems", LogSubsystemMask::all(), Logging, true)

// 1 keeps the current file only. 100 is roughly a year of daily use and is where the rotation
// scan stops being free.
RAWPAGE_SETTING_RANGED(logging, retainFiles, int,
                       "logging/retainFiles", 5, Logging, true, 1, 100)

// --- Documents -------------------------------------------------------------------------------
// 0 is a legitimate value and means "keep no history", which is a privacy setting rather than a
// degenerate one -- so the range starts there rather than at 1.
RAWPAGE_SETTING_RANGED(documents, recentCount, int,
                       "documents/recentCount", 10, Documents, true, 0, 50)

RAWPAGE_SETTING(documents, recentPinned, QStringList,
                "documents/recentPinned", "", Documents, false)


// =============================================================================================
// The sixteen Stage 2 keys -- Implementation-Plan.md, Stage 2 "Data / settings keys".
//
// Eleven `pageDisplay/` and five `performance/`, and adding them here is the WHOLE of the UI work:
// convention 17 means `ui/dialogs/SettingsPage` `#include`s this file and builds one typed editor
// per row, so two new Preferences pages appear with no widget code. Adding a seventeenth is a row.
//
// FOUR OF THESE DEFAULTS WERE ALREADY WRITTEN DOWN IN CODE, and rule 2 says a default lives in one
// place -- so each constant below carries the value its C++ home had, and that home now says the
// row is the owner. Changing one of them here is the way to change it; changing it there is a
// second default that disagrees the first time anyone touches either.
//
//   pageDisplay/maxRenderResolution  <- DpiPolicy::Limits::maxRenderDpi      (2400)
//   performance/tileCacheMB          <- RenderCache::Config::memoryCapBytes  (256 MiB)
//   performance/diskCacheMB          <- RenderCache::Config::diskCapBytes    (0 -- see below)
//   performance/renderWorkers        <- RenderScheduler::Config::workerCount (1  -- see below)
// =============================================================================================

// --- Page display ------------------------------------------------------------------------------
// The arrangement a document opens in. `SingleContinuous` is what every reader defaults to and what
// the viewer has done since T13; a settings task must not silently change what the product does.
RAWPAGE_SETTING(pageDisplay, layoutMode, render::LayoutMode,
                "pageDisplay/layoutMode", render::LayoutMode::SingleContinuous, PageDisplay, true)

// The zoom a document opens at. `None` is "no fitting", which as a default means 100 % -- again the
// behaviour the viewer already had. The other four are the fits.
RAWPAGE_SETTING(pageDisplay, defaultZoom, render::FitMode,
                "pageDisplay/defaultZoom", render::FitMode::None, PageDisplay, true)

// Two-up asymmetries (PagePresentation, plan 5.5). A cover takes a spread of its own, shifting every
// later pair's parity; RTL maps column 0 to the right and changes nothing else.
RAWPAGE_SETTING(pageDisplay, showCoverInTwoUp, bool,
                "pageDisplay/showCoverInTwoUp", false, PageDisplay, true)

RAWPAGE_SETTING(pageDisplay, rtlBinding, bool,
                "pageDisplay/rtlBinding", false, PageDisplay, true)

// Features.md 1.2: "draw hairlines at their true width instead of a minimum of one pixel."
//
// DECLARED AND INERT -- Stage 2 guide issue I-11, a scope finding rather than a defect. PDFium's
// `FPDF_*` render flags have no such control and always enforce the one-pixel minimum, so the ON
// state is a thing this engine cannot be asked for. It is declared here rather than left out
// because the setting is real, the plan lists it, and a row that is absent is indistinguishable
// from a row nobody thought of; the guide's A-65 records the measurement that established it.
RAWPAGE_SETTING(pageDisplay, lineWeight, bool,
                "pageDisplay/lineWeight", false, PageDisplay, true)

// The three anti-aliasing switches, each mapping to one `FPDF_RENDER_NO_SMOOTH*` flag. Default ON,
// which is PDFium's own default and what a page has looked like since T9; turning one off is a
// deliberate choice for a slow machine or for a golden-image comparison.
RAWPAGE_SETTING(pageDisplay, antialiasText, bool,
                "pageDisplay/antialiasText", true, PageDisplay, true)

RAWPAGE_SETTING(pageDisplay, antialiasImages, bool,
                "pageDisplay/antialiasImages", true, PageDisplay, true)

RAWPAGE_SETTING(pageDisplay, antialiasLineArt, bool,
                "pageDisplay/antialiasLineArt", true, PageDisplay, true)

// A checkerboard behind the page instead of white, so a transparent region is visible as
// transparent rather than as white-on-white. A viewer-side decision: the raster is unchanged and
// the SHEET under it is what differs.
RAWPAGE_SETTING(pageDisplay, transparencyGrid, bool,
                "pageDisplay/transparencyGrid", false, PageDisplay, true)

// The cap of Features.md 1.2 -- "trading fidelity for responsiveness". 2400 is `DpiPolicy`'s own
// constant and is 12.5x a 192-DPI panel, so no ordinary zoom on any display this product will meet
// is capped; the floor of 96 is one device pixel per point at 100 % and the ceiling of 4800 is
// where one A4 tile stops fitting in a sensible allocation.
RAWPAGE_SETTING_RANGED(pageDisplay, maxRenderResolution, int,
                       "pageDisplay/maxRenderResolution", 2400, PageDisplay, true, 96, 4800)

// Whether a bare wheel zooms instead of scrolling. Default FALSE: the wheel scrolls, and `Ctrl`
// plus the wheel zooms, which is what every reader does. With this on the two swap over -- `Ctrl`
// then scrolls -- rather than the wheel doing both, because a modifier that does nothing is a
// modifier people stop trying.
RAWPAGE_SETTING(pageDisplay, wheelZooms, bool,
                "pageDisplay/wheelZooms", false, PageDisplay, true)

// S4 T7, and the first of D4-5's fifteen Stage 4 keys. Device pixels per second, and the SIGN IS
// THE DIRECTION: `Features.md` §1.2 asks for auto-scroll *"with pause and reverse"*, and this is
// where reverse lives -- a negative speed -- so that `view.autoScroll` can be one toggle rather
// than three commands. Zero means stopped, and `view.autoScroll` is DISABLED there rather than
// starting something that cannot move.
//
// The range is symmetric and modest: 2000 px/s is about a screen every half-second, which is past
// readable and is the point at which a bound stops being a limit and starts being a guard.
RAWPAGE_SETTING_RANGED(pageDisplay, autoScrollSpeed, int,
                       "pageDisplay/autoScrollSpeed", 60, PageDisplay, true, -2000, 2000)

// --- Performance and cache -----------------------------------------------------------------------
// ONE, and it is I-05's answer rather than a placeholder: PDFium cannot be called from two threads
// at once, so the shipped arrangement is one render thread with a queue. The range goes to 16 because
// T18 re-measures A2 through this pipeline and must be able to walk the count without a rebuild --
// and because a future non-PDFium rasterizer is not bound by that finding. **Above 1 the workers
// serialize on `PdfiumInit`'s engine lock**; they do not go faster, and the T3 probe measured the
// difference at 1.05x.
RAWPAGE_SETTING_RANGED(performance, renderWorkers, int,
                       "performance/renderWorkers", 1, PerformanceAndCache, true, 1, 16)

// 256 MiB is roughly 1000 tiles of 256x256 BGRA -- a 4K viewport's worth at three zoom levels, which
// is what makes zooming out and back in free. 16 is where the cache stops being able to hold one
// screenful and starts costing more than it saves.
RAWPAGE_SETTING_RANGED(performance, tileCacheMB, int,
                       "performance/tileCacheMB", 256, PerformanceAndCache, true, 16, 4096)

// ZERO, AND THE ZERO IS THE DECISION. D2-14: whether the disk tier earns its place is a MEASUREMENT
// T18 makes over the corpus, not a preference expressed here, and a tier switched on by default
// would make that measurement about itself. 0 means the tier is not installed at all.
//
// **T18 MADE THE MEASUREMENT AND THE ANSWER IS NO -- the default stays 0 by evidence rather than by
// inertia.** `tests/bench/bench_pipeline` phase 4 runs the same workload twice, differing only in
// whether a `DiskTileStore` is attached: eight documents, two passes, 144 dpi.
//
//     memory only   0 % hit rate    47 ms    0.118 ms/tile
//     with disk    50 % hit rate   102 ms    0.254 ms/tile
//
// The tier does exactly what a cache is supposed to do -- the hit rate goes from nothing to half --
// and the workload gets **more than twice as slow**. The reason is not a defect in `DiskTileStore`:
// a tile costs about a quarter of a millisecond to RE-RENDER, and no disk round trip beats that.
// A second tier that raises the hit rate and the wall clock together is not a cache, it is a slower
// way to get the same pixels.
//
// The row stays, the code stays, and the range stays -- a user on a machine where rendering is far
// more expensive than this one's may still want it, and Stage 5's text extraction changes the
// workload. What is settled is the DEFAULT, and it is settled with a number.
RAWPAGE_SETTING_RANGED(performance, diskCacheMB, int,
                       "performance/diskCacheMB", 0, PerformanceAndCache, true, 0, 8192)

// How many pages BEYOND the visible ones are rasterized speculatively. Counts PAGES, not tiles --
// within a page the prefetch is `TileGrid`'s ring of tiles, which is a different knob with a
// different unit, and conflating them is how "prefetch 2" comes to mean two tiles.
RAWPAGE_SETTING_RANGED(performance, prefetchPages, int,
                       "performance/prefetchPages", 1, PerformanceAndCache, true, 0, 8)

// Fewer render workers while the machine is on battery. Default ON, and inert on a desktop -- which
// `platform::IPowerSession::hasBattery()` answers, because "no battery" is not "on mains".
RAWPAGE_SETTING(performance, throttleOnBattery, bool,
                "performance/throttleOnBattery", true, PerformanceAndCache, true)

// =============================================================================================
// The two Stage 3 keys -- Stage3-Mutation-Plan.md D3-9, which moved the plan's other two away:
// `documents/saveMode` to Stage 8 (it needs FullWriter) and `documents/autosaveIntervalSec` to Stage 13
// (a journal flushed per command has no interval to configure). Both rows are in the `Documents` group,
// which is what makes the Documents Preferences page ship at T12 (convention 17) -- beside the two
// Stage 1 rows already declared there.
// =============================================================================================

// --- Documents -------------------------------------------------------------------------------
// Where recovery journals are written and discovered. EMPTY MEANS THE DEFAULT,
// `%LOCALAPPDATA%\RawPage\recovery` (`core::RecoveryJournal::defaultRoot()`), for `language/uiLocale`'s reason: no directory is
// named by the empty string. Only an ABSOLUTE path counts -- a relative one would resolve against
// whatever directory the process started in -- so a relative value is ignored and logged
// (`RecoveryJournal::resolveRoot`). It takes effect for documents opened AFTER the change; an open
// document keeps the journal it has. Journals already under the old directory are not moved and are not
// offered from the new one -- the prompt looks where this key says.
RAWPAGE_SETTING(documents, recoveryDir, QString,
                "documents/recoveryDir", "", Documents, true)

// Whether a repaired document's forced Save-As says WHY first (D3-6). ON, because a Save that opens a
// Save As with no word of explanation reads as the product ignoring the command. OFF skips only the
// explanation: **it can never turn the forcing off** -- a setting that did would make the standing rule
// *"a repaired document's first save is forced to Save-As"* a preference. Only the repaired reason is
// gated; a file changed on disk, or an untitled document, still explains itself.
RAWPAGE_SETTING(documents, warnOnRepairedSave, bool,
                "documents/warnOnRepairedSave", true, Documents, true)

// =============================================================================================
// The eleven Stage 4 `units/` rows -- S4 T8, D4-5 and D4-6. They fill the `UnitsAndGuides` group,
// which has existed in `SettingsGroup` since Stage 1 with NO KEYS, and adding them is the whole of
// the Preferences work: `PreferencesDialog::shippedPages()` gains one line and `SettingsPage`
// builds one typed editor per row (convention 17). **Units & Guides is the seventh page of 26.**
//
// ELEVEN ROWS FOR NINE FACTS, and the arithmetic is worth writing down because three documents
// counted it three ways before the code existed (`Stage4-ViewingSurface-Plan.md` §4 said seven
// `units/*` keys, its §6 said eight, and D4-5's total said fifteen for the stage):
//
//   * **The origin offset is ONE fact in TWO rows.** `Features.md` §1.3 asks to "configure grid
//     spacing, subdivisions, colour, and origin offset"; an origin is a POINT, there is no point
//     codec, and a single `units/gridOffset` holding "12,18" would be a compound value parsed by
//     hand -- which is what convention 4 exists to prevent.
//   * **`showRulers`, `showGrid` and `showGuides` are three VISIBILITY rows for the three things
//     this group draws.** `Ctrl+U`, `Ctrl+'` and `view.toggleGuides` each have to write their
//     state somewhere or the toggles do not survive a restart, and `units/snapToGrid` -- a
//     View-menu toggle that D4-5 declares as a preference -- is the precedent that says where.
//     Two of the three with the third somewhere else would be arbitrary.
//
// So: fifteen becomes EIGHTEEN for the stage, with D4-5's two EXCLUSIONS untouched --
// `pageDisplay/continuousScroll` is still not declared (`layoutMode` already encodes it) and
// `units/snapToObjects` still moves to Stage 6 with the objects it would snap to. The stage plan
// and `Implementation-Plan.md` are corrected in the same change as this file.
// =============================================================================================

// --- Units and guides ---------------------------------------------------------------------------
// What the rulers read in. INCHES, and the reason is the PDF point itself: 1 pt is 1/72 inch BY
// DEFINITION of the PDF user space, so an inch is the one unit whose ticks are exact at every
// subdivision this product can draw. A locale-derived default (mm where the paper is A4) is a real
// idea and is NOT done here, because a default that differs per machine is a default two users
// cannot compare over a support call; changing it is one row.
RAWPAGE_SETTING(units, rulerUnit, Unit,
                "units/rulerUnit", Unit::Inches, UnitsAndGuides, true)

// `Ctrl+U` and `Ctrl+'` (Features.md §8, Viewer). OFF, which is what every reader opens as: a
// ruler is a tool a person reaches for, and two of them take 40 px from a first run that should be
// all page. The chord writes this row, so the choice survives the session -- the commands do not
// carry a second copy of the state (rule 2 across surfaces rather than across call sites).
RAWPAGE_SETTING(units, showRulers, bool,
                "units/showRulers", false, UnitsAndGuides, true)

RAWPAGE_SETTING(units, showGrid, bool,
                "units/showGrid", false, UnitsAndGuides, true)

// `view.toggleGuides`, which has no chord in `Features.md` §8 and is reached from the ribbon, the
// tool finder and the batch runner. ON, unlike the other two: hiding a guide does not delete it,
// so a person who drags one out and cannot see it has lost work with no other surface -- whereas a
// ruler and a grid that are off have simply not been asked for.
RAWPAGE_SETTING(units, showGuides, bool,
                "units/showGuides", true, UnitsAndGuides, true)

// POINTS, and every length in this group is. The editor `SettingsPage` generates for a `double` is
// a plain spin box with no unit awareness, so the LABEL says which unit it is in; a spacing that
// followed `rulerUnit` would be a number whose meaning changed when a different control moved.
// 72 pt is one inch -- the spacing every grid in this domain starts at. The floor of 1 pt is where
// a grid stops being distinguishable from a fill at 100 %, and 720 pt is ten inches, past which
// the page holds no line at all.
RAWPAGE_SETTING_RANGED(units, gridSpacing, double,
                       "units/gridSpacing", 72.0, UnitsAndGuides, true, 1.0, 720.0)

// Minor lines per major interval. **The FINEST line is what snapping uses and what is drawn** --
// see `core/Snap.h` -- so this is not a decoration: raising it makes the snap finer. 1 means no
// minor lines at all, which is why the range starts there rather than at 2.
RAWPAGE_SETTING_RANGED(units, gridSubdivisions, int,
                       "units/gridSubdivisions", 4, UnitsAndGuides, true, 1, 20)

// `#RRGGBB`, as TEXT rather than as a colour type: `core/` may not name a Qt GUI type (convention
// 3) and `QColor` is QtGui, so the parse happens in `ui/viewer/GridGuideLayer` and an unreadable
// value falls back there rather than here. **A FIXED default in both themes is correct here and is
// not convention 20's defect**: the grid is painted over the PAGE, whose raster is the document's
// own white in a light theme and in a dark one, so a colour that followed the theme would be
// chosen against a backdrop it never meets.
RAWPAGE_SETTING(units, gridColour, QString,
                "units/gridColour", "#6699CC", UnitsAndGuides, true)

// The page-space point the grid is measured FROM, in points -- so a non-zero offset moves the
// LINES and not the page. Two rows for one fact; see the note at the top of this block. The bound
// is the largest page ISO 32000 permits in either direction (14400 pt = 200 in), beyond which an
// offset cannot put a line on any page.
RAWPAGE_SETTING_RANGED(units, gridOriginX, double,
                       "units/gridOriginX", 0.0, UnitsAndGuides, true, -14400.0, 14400.0)

RAWPAGE_SETTING_RANGED(units, gridOriginY, double,
                       "units/gridOriginY", 0.0, UnitsAndGuides, true, -14400.0, 14400.0)

// `Ctrl+;`. OFF: a snap nobody asked for moves a drag the person could see was where they wanted
// it, and the chord exists precisely because it is turned on for a task and off again.
RAWPAGE_SETTING(units, snapToGrid, bool,
                "units/snapToGrid", false, UnitsAndGuides, true)

// ON, and the asymmetry with `snapToGrid` above is deliberate: a grid appears because a preference
// was set, while a guide exists because a person dragged it onto this page for this task. Snapping
// to it is what it was placed for.
//
// **`units/snapToObjects` IS ABSENT** and is Stage 6's (D4-5, following D3-9): the resolver already
// takes an object-edge span (D4-6) and every product caller passes it EMPTY, so Stage 6 adds a
// source and a key, not an algorithm. A third checkbox here that read back as set and did nothing
// would be Stage 2's I-11 by construction rather than by constraint.
RAWPAGE_SETTING(units, snapToGuides, bool,
                "units/snapToGuides", true, UnitsAndGuides, true)

// --- Full Screen and presentation (S4 T10, D4-12) -----------------------------------------------
// The FIVE rows D4-5 names for this group, which has existed in `SettingsGroup` since Stage 1 with
// no keys in it. Adding them and one line in `PreferencesDialog::shippedPages()` is the whole of
// the Preferences work -- `SettingsPage` builds one typed editor per declared key (convention 17).
// EIGHT of 26 groups ship.

// THE DEFAULT TRANSITION, AND IT IS `none`. A viewer that faded between pages because nobody said
// otherwise would be animating every document, including the 900-page ones nobody is presenting --
// and a transition is a thing a presenter chooses, not a thing a reader discovers. A page's own
// `/Trans` OVERRIDES this (`core/doc/PageTransitions`, guide case A-61), which is the direction
// that makes the document's request win over a preference it knows nothing about.
RAWPAGE_SETTING(fullScreen, transition, TransitionStyle,
                "fullScreen/transition", TransitionStyle::None, FullScreen, true)

// SECONDS between automatic advances, and the row does NOT carry an on/off flag: auto-advance is
// toggled by `present.autoAdvance` (`Ctrl+Shift+H`) during a presentation, which is a gesture
// rather than a preference, and a second row saying whether it is on would be two truths that
// agree until the first Friday. 5 s is a slide a person can read; the floor of 1 s is where the
// next advance arrives before the transition finishes, and 600 s is ten minutes.
RAWPAGE_SETTING_RANGED(fullScreen, autoAdvanceSec, int,
                       "fullScreen/autoAdvanceSec", 5, FullScreen, true, 1, 600)

// Whether auto-advance restarts at page 1 after the last page. OFF: a presentation that silently
// went back to the beginning would be indistinguishable, to someone who looked away, from one that
// never advanced at all.
RAWPAGE_SETTING(fullScreen, loop, bool,
                "fullScreen/loop", false, FullScreen, true)

// WHICH MONITOR, by the display's own `friendlyName` -- "MAG 272URDF", not `\\.\DISPLAY1`. The
// name rather than the index because an index changes when a monitor is unplugged and would then
// name a different panel; and `friendlyName` rather than `MonitorInfo::id` because a `QScreen` is
// named with exactly this string and `id` can never match one (Stage 2's **I-20**). EMPTY means
// the monitor the window is already on, which is what a person expects from pressing `F11`.
RAWPAGE_SETTING(fullScreen, monitor, QString,
                "fullScreen/monitor", "", FullScreen, true)

// Whether the pointer is visible while presenting. ON, because a presenter points at things -- and
// `Ctrl+L` toggles it at runtime, which is why this is a default rather than the state.
RAWPAGE_SETTING(fullScreen, showCursor, bool,
                "fullScreen/showCursor", true, FullScreen, true)

// =============================================================================================
// The ten Stage 5 `search/` rows -- S5 T6, `Implementation-Plan.md` § Stage 5 and
// `Stage5-TextSearch-Plan.md` D5-20. They fill the `Search` group, declared in `SettingsGroup` since
// Stage 1 with no keys, and one line in `PreferencesDialog::shippedPages()` is the rest of the page
// (convention 17). **Nine of 26 groups ship.**
//
// THE FOUR MATCHING FLAGS ARE THE FIND BAR'S TOGGLES (D5-14): `Alt+R`, `Alt+W` and `Alt+C` write the
// first three of these and nothing else, so the bar and this page cannot disagree -- D4-5's rule, one
// truth per fact. `core/text/SearchQuery::fromSettings` is the one reader.
// =============================================================================================

// --- Search ------------------------------------------------------------------------------------
// OFF, all four: a search finds what was typed, anywhere, as typed -- except for CASE, which is folded
// unless `caseSensitive` says otherwise, because every reader folds it by default and a person typing
// `lorem` expects `Lorem`. Diacritics are MATCHED by default: `café` and `cafe` are different words in
// the languages that write them, and ignoring the difference is the choice a person makes, not one made
// for them.
RAWPAGE_SETTING(search, wholeWords, bool,
                "search/wholeWords", false, Search, true)
RAWPAGE_SETTING(search, caseSensitive, bool,
                "search/caseSensitive", false, Search, true)
RAWPAGE_SETTING(search, ignoreDiacritics, bool,
                "search/ignoreDiacritics", false, Search, true)
RAWPAGE_SETTING(search, useRegex, bool,
                "search/useRegex", false, Search, true)

// THE FOUR CONTENT CLASSES BEYOND PAGE TEXT (`Features.md` §1.8, D5-12), which page text always joins.
// OFF by default, as the readers that offer them have them: a search of a document is a search of its
// words unless a person asks for its comments too. Declared at T6; **read since T8** by
// `core/text/SearchQuery::fromSettings`, and each switches what the one read-only reader
// (`IDocumentBackend::searchUnits`) is asked for -- a class switched off is never read
// (`Stage5-TextSearch-Testing-Guide.md` A-76, A-79).
RAWPAGE_SETTING(search, includeComments, bool,
                "search/includeComments", false, Search, true)
RAWPAGE_SETTING(search, includeBookmarks, bool,
                "search/includeBookmarks", false, Search, true)
RAWPAGE_SETTING(search, includeFields, bool,
                "search/includeFields", false, Search, true)
RAWPAGE_SETTING(search, includeAttachments, bool,
                "search/includeAttachments", false, Search, true)

// HOW MANY HITS A LIST HOLDS -- the first N in document order, and a search that reaches it SAYS so
// (guide A-61): a list cut short in silence reads as every hit there is. 10,000 is more than anyone
// steps through with `F3` and few enough that a one-letter query over a 900-page file does not build a
// list of a million entries; the floor of 1 is legal because a limit is a person's choice, and the
// ceiling is where a list stops being a list.
RAWPAGE_SETTING_RANGED(search, maxResults, int,
                       "search/maxResults", 10000, Search, true, 1, 1000000)

// THE TEXT INDEX'S OWN BUDGET, in MB -- D5-4: extracted text is kept outside the tile cache, keyed by
// document, and whole documents are evicted least recently searched first when this is exceeded. The
// default is sized to what it must hold: `corpus/ordinary/text-900.pdf`'s complete index -- 900 dense
// pages, 7.2 million characters, their models, readings and one normalized form -- MEASURED at T6 as
// **835 MB** (guide A-63, `tests/render/tst_searchcorpus.cpp`, which also asserts it fits this default),
// so the guide's *"the second search of a 900-page file is instant"* holds at the default. Most of it is
// the engine's per-character geometry (`PageTextModel`), which selection and highlighting need; a page
// of ordinary prose holds a third of that file's characters. The document being searched is never
// evicted for itself (`DocumentIndex.h`). `core::text::DocumentIndex::kDefaultBudgetBytes` equals this
// row, and `tst_index` says so.
RAWPAGE_SETTING_RANGED(search, indexCacheMB, int,
                       "search/indexCacheMB", 1024, Search, true, 16, 16384)

// =============================================================================================
// Internal state -- same file, same versioning, no Preferences row (rule 4).
// =============================================================================================

// D1-16. Written from the first save of a fresh file, so that a file this build wrote can always be
// told from a file a later build wrote. Read by Settings' constructor before any other key.
RAWPAGE_SETTING(meta, schemaVersion, int,
                "meta/schemaVersion", 1, Internal, false)

// --- The UI customization (T11) ---------------------------------------------------------------
// Internal by rule 4, and the reason is worth stating because these ARE user choices: the surface
// that makes them is the Quick Access Toolbar's own context menu and the tool finder, not a
// Preferences row. A key gets a Preferences row when the Preferences page is where you change it;
// putting these in `General` would give T14 two widgets for one setting, and the second one would
// be the one nobody keeps in sync with the toolbar.
//
// The commands are stored as ACTION STRING IDS, never as enum values. The enum is a build-time
// artifact whose numbering changes every time a row is inserted into ActionId.def; the string id is
// the permanent public name, and `actionFromStringId` resolves a retired one through D1-16's alias
// table -- which is what makes a QAT customization survive a rename in Stage 7.
RAWPAGE_SETTING(ui, qatCommands, QStringList,
                "ui/qatCommands", "", Internal, false)

RAWPAGE_SETTING(ui, qatBelowRibbon, bool,
                "ui/qatBelowRibbon", false, Internal, false)

// Locking the toolbar stops a drag from reordering it. Default UNLOCKED: dragging a button to a
// new place is the gesture people expect from a toolbar, and a lock is an opt-in guard against
// doing it by accident -- the reverse default would make the feature invisible to the person who
// never opens the context menu.
RAWPAGE_SETTING(ui, qatLocked, bool,
                "ui/qatLocked", false, Internal, false)

// The recent-files list itself. `documents/recentCount` bounds it and `documents/recentPinned`
// says which of its entries survive eviction; the ordered list has to live somewhere, and an
// undeclared key is exactly what D1-10 exists to make impossible.
RAWPAGE_SETTING(documents, recentList, QStringList,
                "documents/recentList", "", Internal, false)

#undef RAWPAGE_SETTING
#undef RAWPAGE_SETTING_RANGED

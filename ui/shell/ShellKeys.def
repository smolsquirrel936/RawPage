// -*- C++ -*-  THE SHELL'S CATALOG KEYS. One table, two artifacts -- the same shape as
// ActionId.def, SettingsKeys.def and KeyBindingDefaults.def, and for the same reason (D1-6).
//
// The `constexpr` key constants the widgets use, and the list `--dump-ui-strings` prints, both come
// from the rows below. That matters more than it looks: guide case A-72 compares an `en` run
// against a `--lang zh-TW` run, and the case is only worth anything if the dump covers every string
// the shell can put on screen. Two lists would let a key be added to the UI and not to the dump,
// and the case would keep passing while covering less.
//
// This file is #included repeatedly with different macro definitions. No include guard, on purpose.
//
//   RAWPAGE_SHELL_STRING(Enumerator, "shell.key.path")
//
// THE KEY IS A PERMANENT PUBLIC NAME, exactly as an ActionId string or a settings path is: it is
// what the two shipped catalogs are keyed on. Renaming one without renaming it in
// i18n/rawpage_en.ts and i18n/rawpage_zh_TW.ts is caught by tools/i18n-lint -- the old key becomes
// an orphan (S3, reported) and the new one becomes a miss.

#ifndef RAWPAGE_SHELL_STRING
#define RAWPAGE_SHELL_STRING(Enumerator, Key)
#endif

// --- The window --------------------------------------------------------------------------------
// `shell.window.titleWithDocument` arrived at T12 WITH the tab that gives it a `%1`, which is the
// rule this table has followed since T6: a key that leads its use is an `orphan-key` note on every
// gate run -- reported rather than failed (S3), but a report nobody can act on is a report people
// learn to skip.
RAWPAGE_SHELL_STRING(WindowTitle,            "shell.window.title")
RAWPAGE_SHELL_STRING(WindowTitleWithDocument,"shell.window.titleWithDocument")

// --- The central surface -------------------------------------------------------------------------
// Stage 2 replaces this whole widget with `ui/viewer/PageView`. The keys are named for what they
// are -- a placeholder -- so that nobody mistakes them for the start page Features.md describes.
RAWPAGE_SHELL_STRING(PlaceholderHeading,     "shell.placeholder.heading")
RAWPAGE_SHELL_STRING(PlaceholderBody,        "shell.placeholder.body")
RAWPAGE_SHELL_STRING(PlaceholderInterfaces,  "shell.placeholder.interfaces")

// --- The sidebar -------------------------------------------------------------------------------
RAWPAGE_SHELL_STRING(SidebarTitle,           "shell.sidebar.title")
RAWPAGE_SHELL_STRING(SidebarEmpty,           "shell.sidebar.empty")
RAWPAGE_SHELL_STRING(SidebarShow,            "shell.sidebar.show")
RAWPAGE_SHELL_STRING(SidebarHide,            "shell.sidebar.hide")
RAWPAGE_SHELL_STRING(SidebarAutoHide,        "shell.sidebar.autoHide")
RAWPAGE_SHELL_STRING(SidebarPinOpen,         "shell.sidebar.pinOpen")
RAWPAGE_SHELL_STRING(SidebarFloat,           "shell.sidebar.float")
RAWPAGE_SHELL_STRING(SidebarDockLeft,        "shell.sidebar.dockLeft")
RAWPAGE_SHELL_STRING(SidebarDockRight,       "shell.sidebar.dockRight")

// --- The panes (S4 T5) ---------------------------------------------------------------------------
// A NEW FAMILY, `panes.`, added to `tools/i18n-lint/rules.json` in the same change. It is added
// because the NAMESPACE is new, not because the feature is -- Stage 3's I-16 is the record of the
// other reading, where a case demanded a `recovery` family for strings that shipped, correctly, as
// `shell.recovery.*`. A pane is a `ui/panes/` widget with its own catalog namespace; its chrome
// inside the sidebar stays `shell.sidebar.*`.
//
// They live in THIS table rather than in one of their own so that `catalog::dumpStrings()` -- which
// is generated from this file -- keeps covering every string the product can put on screen. Guide
// case A-72 compares an `en` run against a `--lang zh-TW` run and is worth exactly as much as that
// coverage; `ui/panes/LogPane` set the precedent by taking its keys from here at T14.
RAWPAGE_SHELL_STRING(PanesThumbnailsTitle,   "panes.thumbnails.title")
RAWPAGE_SHELL_STRING(PanesThumbnailsEmpty,   "panes.thumbnails.empty")
RAWPAGE_SHELL_STRING(PanesBookmarksTitle,    "panes.bookmarks.title")
RAWPAGE_SHELL_STRING(PanesBookmarksEmpty,    "panes.bookmarks.empty")
RAWPAGE_SHELL_STRING(PanesDestinationsTitle, "panes.destinations.title")
RAWPAGE_SHELL_STRING(PanesDestinationsEmpty, "panes.destinations.empty")
RAWPAGE_SHELL_STRING(PanesDestinationsColumnName, "panes.destinations.column.name")
RAWPAGE_SHELL_STRING(PanesDestinationsColumnPage, "panes.destinations.column.page")

// Shown on a bookmark or a destination whose page is not in the document -- `dests-named.pdf`
// carries one deliberately, as T1's control. It is a STATEMENT rather than an error: the row stays
// in the list, because a destination silently missing reads as a document with fewer than it has.
RAWPAGE_SHELL_STRING(PanesDestinationsUnresolved, "panes.destinations.unresolved")

// --- The status bar ----------------------------------------------------------------------------
RAWPAGE_SHELL_STRING(StatusReady,            "shell.status.ready")
RAWPAGE_SHELL_STRING(StatusNoDocument,       "shell.status.noDocument")
RAWPAGE_SHELL_STRING(StatusPage,             "shell.status.page")

// The em dash shown for a page count that does not exist. A catalog entry rather than a literal,
// and rather than an i18n-lint waiver, because it genuinely is translatable: CJK typography sets a
// dash differently from Latin typography, and "it is only punctuation" is how a product ends up
// with a Latin em dash in the middle of a Chinese status bar. The gate caught this one at T9.
RAWPAGE_SHELL_STRING(StatusPageCountUnknown, "shell.status.pageCountUnknown")
RAWPAGE_SHELL_STRING(StatusZoom,             "shell.status.zoom")
RAWPAGE_SHELL_STRING(StatusTasksIdle,        "shell.status.tasksIdle")
// S5 T5 (D5-9). What a copy of the text selection did. `NotExtractable` is the one that matters most:
// glyphs with no trustworthy Unicode are refused rather than pasted (D5-2, guide A-21), and a copy that
// silently did nothing would read as the product being broken.
RAWPAGE_SHELL_STRING(StatusSelectionCopied,          "shell.status.selectionCopied")
RAWPAGE_SHELL_STRING(StatusSelectionCopiedSkipped,   "shell.status.selectionCopiedSkipped")
RAWPAGE_SHELL_STRING(StatusSelectionNotExtractable,  "shell.status.selectionNotExtractable")
RAWPAGE_SHELL_STRING(StatusSelectionPreparing,       "shell.status.selectionPreparing")
RAWPAGE_SHELL_STRING(StatusSelectionCopyCancelled,   "shell.status.selectionCopyCancelled")
RAWPAGE_SHELL_STRING(StatusSnapshotCopied,           "shell.status.snapshotCopied")
RAWPAGE_SHELL_STRING(StatusSnapshotReduced,          "shell.status.snapshotReduced")
RAWPAGE_SHELL_STRING(StatusSnapshotFailed,           "shell.status.snapshotFailed")

// --- Theme names -------------------------------------------------------------------------------
// Named here rather than in the Preferences pages (T14) because the status of the current theme is
// reported by the shell itself, and a theme name that read one way in Preferences and another in
// the status bar would be the first localization bug anyone filed.
RAWPAGE_SHELL_STRING(ThemeLight,             "shell.theme.light")
RAWPAGE_SHELL_STRING(ThemeDark,              "shell.theme.dark")
RAWPAGE_SHELL_STRING(ThemeFollowSystem,      "shell.theme.followSystem")

// --- The ribbon (T10) --------------------------------------------------------------------------
// ONLY the keys the ribbon's CODE names. Every tab and group title lives in `res/ribbon.json` and
// is resolved from there -- putting them here as well would be two lists of the same names, which
// is the exact drift D1-6 exists to prevent. `Catalog::dumpStrings()` reads the shipped spec so
// that guide case A-72 still covers all of them; see that function.
RAWPAGE_SHELL_STRING(RibbonOverflowGlyph,    "ribbon.overflow.glyph")
RAWPAGE_SHELL_STRING(RibbonOverflowTooltip,  "ribbon.overflow.tooltip")

// The tooltip on a DECLARED but UNREGISTERED command -- most of the ribbon at Stage 1, and a
// shrinking share of it through Stage 13. `%1` is the command's own label. It deliberately does not
// name a stage number: `ActionId.def` does not carry one, and a hand-maintained "arrives in Stage 7"
// per action would be 358 facts nobody updates when a plan moves.
RAWPAGE_SHELL_STRING(RibbonTooltipUnregistered, "ribbon.tooltip.unregistered")

// The OTHER kind of disabled -- STAGE 1'S I-53, finally built at Stage 2 T14. A control that is
// registered and currently refused says something different from one that is not built: the first
// is about this document, the second is about this build, and the fix a user reaches for is
// different for each. Stage 1 built only the second, and the distinction was alive everywhere
// except on the surface (`dispatch` separates `Unavailable` from `NotFound`, the log prints them
// under different keys, `ShortcutBinder` consumes the key for one and not the other).
//
// `%1` is the command's own label. A registration may name a MORE SPECIFIC reason through
// `ActionRegistry::Registration::tooltipKey`, and the three below are Stage 2's -- the generic one
// is what a registration that named none falls back to, rather than the label, which would say
// nothing at all.
RAWPAGE_SHELL_STRING(RibbonTooltipUnavailable,  "shell.ribbon.tooltip.unavailable")
RAWPAGE_SHELL_STRING(TooltipNeedsDocument,      "shell.tooltip.needsDocument")
// S4 T8. What `view.lockGuide` and `view.deleteGuide` say when the pointer is not over a guide:
// they are DISABLED there rather than absent, wherever they are reached from a surface that shows
// every command (the tool finder, the QAT). The context menu offers them only over a guide.
RAWPAGE_SHELL_STRING(TooltipNeedsGuide,         "shell.tooltip.needsGuide")
// S4 T11. What tile, cascade and merge say with one window open: they are DISABLED rather than
// absent, because arranging one window is not an operation and a control that appeared to work and
// did nothing would be Stage 1's I-53 again. `window.list` is NOT among them -- a list of one is a
// true statement about the application.
RAWPAGE_SHELL_STRING(TooltipNeedsWindows,       "shell.tooltip.needsWindows")
// S5 T5. What `edit.copy` says with nothing selected -- DISABLED there, and still consuming `Ctrl+C`
// where it falls through to Common, which is §8's row doing its job (D5-9).
RAWPAGE_SHELL_STRING(TooltipNeedsSelection,     "shell.tooltip.needsSelection")
// S5 T13. What `nav.nextDifference` and `nav.prevDifference` say with no comparison open, or one that found
// nothing: DISABLED there, and still consuming `Ctrl+]` and `Ctrl+[`, which §8 binds in the Viewer.
RAWPAGE_SHELL_STRING(TooltipNeedsComparison,    "shell.tooltip.needsComparison")
RAWPAGE_SHELL_STRING(TooltipAtFirstPage,        "shell.tooltip.atFirstPage")
RAWPAGE_SHELL_STRING(TooltipAtLastPage,         "shell.tooltip.atLastPage")

// --- The message bar and the password prompt (S2 T14) --------------------------------------------
RAWPAGE_SHELL_STRING(MessageBarDismiss,         "shell.messageBar.dismiss")
RAWPAGE_SHELL_STRING(MessageBarDetails,         "shell.messageBar.details")
RAWPAGE_SHELL_STRING(MessageBarDocumentPrefix,  "shell.messageBar.documentPrefix")
RAWPAGE_SHELL_STRING(MessageBarProtected,       "shell.messageBar.protected")
RAWPAGE_SHELL_STRING(RepairDetailTitle,         "shell.repair.detail.title")
RAWPAGE_SHELL_STRING(RepairDetailIntro,         "shell.repair.detail.intro")
RAWPAGE_SHELL_STRING(RepairDetailTruncated,     "shell.repair.detail.truncated")
RAWPAGE_SHELL_STRING(PasswordTitle,             "shell.password.title")
RAWPAGE_SHELL_STRING(PasswordPrompt,            "shell.password.prompt")
RAWPAGE_SHELL_STRING(PasswordRetry,             "shell.password.retry")
RAWPAGE_SHELL_STRING(PasswordLabel,             "shell.password.label")

// The status bar's page total and its zoom FIGURE (S2 T14). `shell.status.zoom` already exists and
// is the word "Zoom" beside the box; this is the number in it, and it needs a key of its own because
// a percent sign is not the same character in every locale and does not sit on the same side of the
// digits. `%1` is the page count and the zoom percentage respectively.
RAWPAGE_SHELL_STRING(StatusPageTotal,           "shell.status.pageTotal")
RAWPAGE_SHELL_STRING(StatusZoomValue,           "shell.status.zoomValue")

// --- The Quick Access Toolbar (T11) ------------------------------------------------------------
// Note what is NOT here: "Add to Quick Access Toolbar", "Remove from …" and the placement item
// itself. Those are COMMANDS -- `ui.qatAdd`, `ui.qatRemove`, `ui.qatPlacement` -- and a command's
// label comes from `ActionId.def` through `action.*`, never from a second key here. Spelling one
// of them again in this table is exactly the drift D1-6 exists to prevent, and it would put two
// different words on the same command in two different places in the UI.
RAWPAGE_SHELL_STRING(QatTitle,               "shell.qat.title")
RAWPAGE_SHELL_STRING(QatEmpty,               "shell.qat.empty")

// The tooltip on `ui.qatPlacement`, whose label is a NOUN ("Quick Access Toolbar Placement") and so
// cannot say which way the toggle currently points. The check mark says that; this says what the
// check mark means, which a check mark on its own never does.
RAWPAGE_SHELL_STRING(QatPlacementHint,       "shell.qat.placementHint")

// --- The tool finder (T11) -----------------------------------------------------------------------
RAWPAGE_SHELL_STRING(ToolFinderPlaceholder,  "shell.toolFinder.placeholder")
RAWPAGE_SHELL_STRING(ToolFinderNoResults,    "shell.toolFinder.noResults")

// A hit for a command that is DECLARED but not yet registered. The tool finder shows it disabled
// rather than hiding it, for the same reason the ribbon does (guide case A-56): a command the
// product names and cannot run is a fact about the stage, and hiding it makes the search results
// silently disagree with the ribbon the user is looking at.
RAWPAGE_SHELL_STRING(ToolFinderUnavailable,  "shell.toolFinder.unavailable")

// --- Documents and their tabs (T12) --------------------------------------------------------------
// `shell.document.placeholderBody` was HERE and is GONE, removed at Stage 2 T13 along with the stub
// it described ("... the PDF engine and the page surface arrive with Stage 2"). A key whose text
// promises a stage that has arrived is worse than no key: it is a sentence the product would still
// be showing after the thing it apologizes for exists. Removed from both shipped catalogs in the
// same change, which is what takes the catalog count from 561 to 560.
RAWPAGE_SHELL_STRING(DocumentUntitled,        "shell.document.untitled")
RAWPAGE_SHELL_STRING(TabStripHint,            "shell.tab.stripHint")

// The file dialog `file.open` raises. Qt supplies its own translated chrome; the title and the
// filter are ours, and a filter string is a user-facing sentence in every locale that has a word
// for "documents".
RAWPAGE_SHELL_STRING(DialogOpenTitle,         "shell.dialog.openTitle")
RAWPAGE_SHELL_STRING(DialogPdfFilter,         "shell.dialog.pdfFilter")

// --- The Preferences dialog and the log pane (T14) ----------------------------------------------
// ONLY the keys this code spells out. The three families that are BUILT from a table are not here
// and must not be: one label per declared settings key (`core::settingsLabelKey`), one per member
// of a closed choice set, one per preference group and one per `KeyContext`. Listing them would be
// a second copy of `SettingsKeys.def`, `SettingsGroup` and `KeyContext` -- exactly the drift D1-6
// exists to prevent -- so `Catalog::dumpStrings()` walks those tables instead and A-72 still covers
// every one of them.
//
// `tools/i18n-lint` treats a quoted reference ending in a dot as a NAMESPACE reference, which is
// what keeps the generated keys from being reported as orphans on every run.
RAWPAGE_SHELL_STRING(PrefsWindowTitle,            "prefs.window.title")
RAWPAGE_SHELL_STRING(PrefsButtonRestoreDefaults,  "prefs.button.restoreDefaults")
RAWPAGE_SHELL_STRING(PrefsButtonClose,            "prefs.button.close")
RAWPAGE_SHELL_STRING(PrefsShortcutsContext,       "prefs.shortcuts.context")
RAWPAGE_SHELL_STRING(PrefsShortcutsColumnCommand, "prefs.shortcuts.columnCommand")
RAWPAGE_SHELL_STRING(PrefsShortcutsColumnChord,   "prefs.shortcuts.columnChord")
RAWPAGE_SHELL_STRING(PrefsShortcutsColumnSource,  "prefs.shortcuts.columnSource")
RAWPAGE_SHELL_STRING(PrefsShortcutsSourceDefault, "prefs.shortcuts.sourceDefault")
RAWPAGE_SHELL_STRING(PrefsShortcutsSourceCustom,  "prefs.shortcuts.sourceCustom")
RAWPAGE_SHELL_STRING(PrefsShortcutsSourceWidget,  "prefs.shortcuts.sourceWidget")
RAWPAGE_SHELL_STRING(PrefsShortcutsCapture,       "prefs.shortcuts.capture")
RAWPAGE_SHELL_STRING(PrefsShortcutsAssign,        "prefs.shortcuts.assign")
RAWPAGE_SHELL_STRING(PrefsShortcutsReset,         "prefs.shortcuts.reset")
RAWPAGE_SHELL_STRING(PrefsShortcutsNoShadows,     "prefs.shortcuts.noShadows")
RAWPAGE_SHELL_STRING(PrefsShortcutsShadowsHeading, "prefs.shortcuts.shadowsHeading")
RAWPAGE_SHELL_STRING(PrefsShortcutsShadowLine,    "prefs.shortcuts.shadowLine")
RAWPAGE_SHELL_STRING(PrefsLogTitle,               "prefs.log.title")
RAWPAGE_SHELL_STRING(PrefsLogLevel,               "prefs.log.level")

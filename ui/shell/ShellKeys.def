RAWPAGE_SHELL_STRING(PrefsToolDefaultsTitle,      "prefs.toolDefaults.title")
RAWPAGE_SHELL_STRING(PrefsToolDefaultsTool,       "prefs.toolDefaults.tool")
RAWPAGE_SHELL_STRING(PrefsToolDefaultsReset,      "prefs.toolDefaults.reset")

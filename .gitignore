# Build trees — every preset writes under build/
/build/
/out/

# vcpkg manifest-mode install tree (the manifest + pinned baseline are what we commit)
vcpkg_installed/

# Per-developer CMake overrides — CMakePresets.json IS committed, this one never is
CMakeUserPresets.json

# Vendored third-party skill set: its own upstream repo, not part of this project's history.
# See CLAUDE.md — it generated the design docs and is not edited as part of product work.
claude-plan/skills-specs-generation/

# Prebuilt PDFium: fetched and hash-verified by scripts/fetch-pdfium.ps1, never committed.
# The pin (version + SHA-256) lives in that script and in third_party/pdfium/README.md,
# which ARE committed -- the reproducibility is in the pin, not in the bytes.
# Note the trailing /* rather than /: git does not descend into an excluded DIRECTORY, so
# the negation below would never be reached and the README would silently go untracked.
/third_party/pdfium/*
!/third_party/pdfium/README.md

# IDE / editor
.vs/
.idea/
.vscode/
*.user

# Python bytecode. The corpus generators (Stage 2 T4) are the only Python in the tree that is
# imported rather than merely run -- make-corpus.py loads the make-*.py scripts through importlib
# -- so __pycache__ appears under corpus/ the first time the reproducibility gate runs.
__pycache__/
*.py[cod]

# OS noise
Thumbs.db
.DS_Store

# NOTE: THIRD-PARTY.md is generated by tools/license-audit but is deliberately NOT ignored —
# Tech-Stack-Plan.md 8.2 requires it committed and tagged per release.

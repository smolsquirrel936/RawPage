    {
      "$comment": [
        "THE CONTEXTUAL TAB. Criterion R-4 of the A3 verdict: it must appear and disappear without",
        "changing the ribbon's height or flickering the tab strip. Stage 1 proves the MECHANISM with",
        "one real tab; the other contextual tabs Features.md 1.1 names -- Picture Tools, Field Tools",
        "-- are per-feature content and belong to the stages that build those features.",
        "",
        "It is declared here rather than constructed in code so that it goes through exactly the same",
        "build path as every other tab. A contextual tab assembled by hand would be the one tab whose",
        "buttons were not validated against ActionId.def."
      ],
      "id": "tableTools",
      "title": "ribbon.tab.tableTools",
      "contextual": true,
      "groups": [
        {
          "id": "tableTools.table",
          "title": "ribbon.group.table",
          "collapsePriority": 1,
          "controls": [
            { "action": "write.insertTable", "size": "large" },
            { "action": "write.autoSum", "size": "small" },
            { "action": "write.insertCaption", "size": "small" },
